@inherits LayoutComponentBase

<div class="app-shell">
    <header class="site-header">
        <a class="brand" href="">MathML Validation</a>
        <nav aria-label="Validation resources">
            <a href="navigation-probe" data-enhance-nav="true">Navigation probe</a>
            <a href="mathml-reference.html" target="_blank">Plain HTML reference</a>
            <a href="https://github.com/dotnet/aspnetcore/issues/68541"
               target="_blank"
               rel="noreferrer">Issue #68541</a>
        </nav>
    </header>

    <main class="app-content">
        @Body
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <button type="button" class="dismiss" aria-label="Dismiss">x</button>
</div>
